{
  "name": "pi-desktop",
  "version": "0.1.0",
  "description": "Electron desktop GUI for the Pi coding agent",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "proxy:fmt": "scripts\\cargo-vs.cmd fmt --manifest-path runtime-proxy\\Cargo.toml",
    "proxy:check": "scripts\\cargo-vs.cmd check --manifest-path runtime-proxy\\Cargo.toml",
    "proxy:build": "scripts\\cargo-vs.cmd build --manifest-path runtime-proxy\\Cargo.toml",
    "proxy:run": "scripts\\cargo-vs.cmd run --manifest-path runtime-proxy\\Cargo.toml",
    "rebuild": "node scripts/electron-rebuild.mjs",
    "postinstall": "node scripts/electron-rebuild.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "better-sqlite3": "^11.10.0",
    "electron-store": "8.2.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@playwright/test": "^1.49.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
